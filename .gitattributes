* text=auto eol=lf
*.bat text eol=crlf

# GitHub Linguist Overrides
# Exclude test suites, automation scripts, and deployment helpers from repository language stats
*.mjs -linguist-detectable
*.js -linguist-detectable
*.ps1 -linguist-detectable
*.sh -linguist-detectable
*.sql -linguist-detectable
*.bat -linguist-detectable

tests/** linguist-vendored
tests/** -linguist-detectable
deploy/** linguist-vendored
deploy/** -linguist-detectable
scripts/** linguist-vendored
scripts/** -linguist-detectable
docs/** linguist-documentation


