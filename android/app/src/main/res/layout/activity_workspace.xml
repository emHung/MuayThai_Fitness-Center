<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/workspaceRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp"
        android:paddingTop="10dp" android:paddingBottom="8dp"
        android:minHeight="80dp" android:orientation="horizontal">
        <ImageButton android:id="@+id/back" android:layout_width="@dimen/header_icon_size" android:layout_height="@dimen/header_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back"
            android:contentDescription="@string/back" android:visibility="gone" />
        <ImageView android:id="@+id/screenIcon" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="8dp" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/workspaceTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="21sp" android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView android:id="@+id/workspaceSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:textSize="11sp" android:maxLines="2"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
        <ImageButton android:id="@+id/notices" android:layout_width="@dimen/header_icon_size" android:layout_height="@dimen/header_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_inbox"
            android:contentDescription="@string/notifications" />
        <ImageButton android:id="@+id/accounts" android:layout_width="@dimen/header_icon_size" android:layout_height="@dimen/header_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_user"
            android:contentDescription="@string/account" />
    </LinearLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/loading"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:indeterminate="true" android:visibility="gone" />
    <TextView android:id="@+id/screenError" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="8dp"
        android:textColor="@color/error" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <ScrollView android:id="@+id/workspaceScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/workspaceBody" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingStart="@dimen/page_padding" android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="18dp" android:orientation="vertical" />
    </ScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/workspaceNav" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface" app:labelVisibilityMode="labeled" app:elevation="0dp" />
</LinearLayout>
