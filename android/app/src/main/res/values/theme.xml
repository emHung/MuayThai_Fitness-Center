<resources>
    <color name="background">#F6F7F5</color>
    <color name="surface">#FFFFFF</color>
    <color name="text_primary">#17211E</color>
    <color name="text_secondary">#4E6059</color>
    <color name="admin">#243348</color>
    <color name="trainer">#1C6557</color>
    <color name="border">#E3E7E2</color>
    <color name="learner">#AD2A3E</color>
    <color name="error">#9B2632</color>

    <style name="Theme.MuayThai.Base" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/admin</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MuayThai" parent="Theme.MuayThai.Base" />
    <style name="Theme.MuayThai.Trainer" parent="Theme.MuayThai">
        <item name="colorPrimary">@color/trainer</item>
    </style>
    <style name="Theme.MuayThai.Learner" parent="Theme.MuayThai">
        <item name="colorPrimary">@color/learner</item>
    </style>
    <style name="Widget.MuayThai.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/field_radius</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>
</resources>
